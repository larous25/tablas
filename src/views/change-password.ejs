<!DOCTYPE html>
<html lang="es" data-theme="cupcake">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cambio de contraseña</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen flex items-center justify-center bg-base-200">

    <div class="card w-96 bg-base-100 shadow-xl">
        <div class="card-body">
            <% if (error) { %>
                <div class="alert alert-error">
                    <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span>Token inválido o expirado.</span>
                </div>
            <% } else { %>
                <h2 class="card-title justify-center text-2xl mb-4">Cambiar contraseña</h2>

                <form id="changePasswordForm" class="space-y-4">
                    <div class="form-control">
                        <label class="label"><span class="label-text">Nueva contraseña</span></label>
                        <input type="password" id="password" placeholder="Escribe tu nueva clave" class="input input-bordered w-full" required>
                    </div>

                    <div class="card-actions mt-4">
                        <button type="submit" class="btn btn-primary w-full">Actualizar</button>
                    </div>
                </form>

                <p id="error" class="text-error text-center mt-2 text-sm"></p>
            <% } %>
        </div>
    </div>

    <script type="module" src="/js/change-password.js"></script>
</body>
</html>