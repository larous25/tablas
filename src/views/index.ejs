<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<title>Tablas</title>

	<link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-base-200 min-h-screen p-8">

    <div class="max-w-4xl mx-auto space-y-6">
        <h1 class="text-3xl font-bold text-base-content">Bienvenido a la aplicación de tablas</h1>

        <% if (error !== '') { %>
            <div class="alert alert-error shadow-lg">
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (redirect !== '') { %>
        <div class="alert alert-warning shadow-lg">
            <div>
                <span>Debes iniciar sesión para acceder.</span>
            </div>

            <div class="ml-auto">
                <a href="<%= redirect %>" class="btn btn-sm btn-outline">
                    Iniciar sesión
                </a>
            </div>
        </div>
        <% } else if(users && products) { %>
            
			<div class="tabs tabs-boxed">
				<button id="tab-products" class="tab tab-active">Productos</button>
				<button id="tab-users" class="tab">Usuarios</button>
			</div>

            <%- include('includes/products', { products, productsTotalPages, usersPage, authToken }) %>
            <%- include('includes/users', { users, usersTotalPages, productsPage, authToken }) %>

	        <script src="/js/index.js"></script>
        <% } %>
    </div>

</body>

</html>