<!DOCTYPE html>
<html lang="es" data-theme="cupcake">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="min-h-screen flex items-center justify-center bg-base-200">

    <div class="card w-96 bg-base-100 shadow-xl">
        <div class="card-body">
            <h2 class="card-title justify-center text-2xl mb-4">Iniciar Sesión</h2>
            
            <form id="loginForm" class="space-y-4">
                <div class="form-control">
                    <label class="label"><span class="label-text">Usuario</span></label>
                    <input type="text" name="name" placeholder="Tu usuario" class="input input-bordered w-full" required>
                </div>
                
                <div class="form-control">
                    <label class="label"><span class="label-text">Contraseña</span></label>
                    <input type="password" name="password" placeholder="••••••••" class="input input-bordered w-full" required>
                </div>

                <div class="card-actions mt-4">
                    <button type="submit" class="btn btn-primary w-full">Ingresar</button>
                </div>
            </form>

            <p id="error" class="text-error text-center mt-2 text-sm"></p>
        </div>
    </div>

    <script type="module" src="/js/login.js"></script>
</body>
</html>